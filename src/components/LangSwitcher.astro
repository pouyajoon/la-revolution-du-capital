---
import type { Locale } from '../i18n/locales';
import { homePath, localeMeta, locales } from '../i18n/locales';
import { t } from '../i18n/ui';

type Props = {
  locale: Locale;
  /** Override alternate URLs (e.g. chapter ↔ chapter). Defaults to home. */
  alternateHrefs?: Partial<Record<Locale, string>>;
};

const { locale, alternateHrefs } = Astro.props;
const strings = t(locale);
---

<nav class="lang-switch" aria-label={strings.langSwitchAria}>
  {
    locales.map((loc) => {
      const href = alternateHrefs?.[loc] ?? homePath(loc);
      const current = loc === locale;
      return (
        <a href={href} aria-current={current ? 'true' : undefined} lang={localeMeta[loc].lang}>
          {localeMeta[loc].label}
        </a>
      );
    })
  }
</nav>
